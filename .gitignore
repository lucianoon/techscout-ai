# Segredos — nunca versionar
.env
.env.local
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
*.egg

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Artefatos gerados pela ingestão (ChromaDB, grafo serializado).
# `data/` é ignorado por padrão, exceto o corpus de exemplo e o dataset de
# avaliação, que são versionados por serem entrada e não saída.
# Os artefatos do corpus de exemplo (grafo + índices) também são versionados:
# a demo pública na Render não tem disco persistente e os recebe via imagem.
data/*
!data/samples/
!data/eval/
!data/graph_data.json
!data/chroma_db/
!data/chroma_graph_nodes/
*.pkl

# Logs
logs/
*.log

# Testes e qualidade
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.json
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
