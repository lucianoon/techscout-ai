# Copie para .env e preencha. O .env é ignorado pelo git — nunca faça commit dele.

# --- Obrigatório ---------------------------------------------------------
# Chave da OpenAI, usada para extração de triplas e embeddings.
OPENAI_API_KEY=sk-sua-chave-aqui

# --- Modelo --------------------------------------------------------------
OPENAI_MODEL=gpt-3.5-turbo
# Temperatura 0: a extração de triplas precisa ser reprodutível.
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Fontes de dados (opcional) ------------------------------------------
# Sem NEWSAPI_KEY, a ingestão usa apenas feeds RSS, que não exigem chave.
# NEWSAPI_KEY=

# --- Recuperação ---------------------------------------------------------
# Quantos documentos a busca vetorial retorna por consulta.
VECTOR_SEARCH_K=3
# Graus de separação percorridos no grafo a partir dos nós encontrados.
GRAPH_EXPANSION_DEPTH=1
RESPONSE_CACHE_MAX_ENTRIES=128

# --- Armazenamento -------------------------------------------------------
CHROMA_COLLECTION_NAME=tech_news
GRAPH_NODE_COLLECTION_NAME=graph_nodes

# Sobrescreva para apontar dados e logs para fora do diretório do projeto.
# TECHSCOUT_DATA_DIR=
# TECHSCOUT_LOGS_DIR=

# Carregar grafo em formato pickle legado executa código arbitrário do
# arquivo. Mantenha em 0 e reexecute a ingestão em vez de habilitar.
ALLOW_PICKLE_GRAPH_LOAD=0

# --- Observabilidade -----------------------------------------------------
LOG_LEVEL=INFO
